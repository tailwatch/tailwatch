<?xml version="1.0"?>
<ruleset name="Tailwatch">
	<description>WordPress.org security and compliance sniffs for the Tailwatch plugin.</description>

	<!-- Scan hand-written plugin PHP only. -->
	<file>.</file>
	<exclude-pattern>*/admin-app/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/Admin/View/Static/*</exclude-pattern>
	<exclude-pattern>*/dev/*</exclude-pattern>
	<exclude-pattern>*/_smoke-test/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<!-- The sniffs that map to the top WordPress.org rejection reasons:
	     output escaping, input sanitization, nonces, prepared SQL,
	     filesystem/HTTP alternatives, i18n, and global prefixing. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.AlternativeFunctions"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="tailwatch"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="tailwatch"/>
				<element value="TAILWATCH"/>
				<element value="Tailwatch"/>
			</property>
		</properties>
	</rule>
</ruleset>
