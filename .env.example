# Local dev-server settings for `npm start` (React Fast Refresh inside wp-admin).
# Copy this file to `.env` — see README.md "Local development (hot reload)".
# `.env` is git-ignored. `npm start` reads it via scripts/dev-server.js.

# Don't auto-open the http://localhost:3000 tab — it has no WordPress, so the app
# would throw "tailwatch_ajax is not defined". You use the wp-admin tab instead.
BROWSER=none

# Let Fast Refresh's websocket connect across the wp-admin / dev-server origins.
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000